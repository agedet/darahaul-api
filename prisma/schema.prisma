  confirmation_token          String?                 @unique(map: "confirmation_token_idx", where: raw("((confirmation_token)::text !~ '^[0-9 ]*$'::text)")) @db.VarChar(255)
  confirmation_sent_at        DateTime?               @db.Timestamptz(6)
  recovery_token              String?                 @unique(map: "recovery_token_idx", where: raw("((recovery_token)::text !~ '^[0-9 ]*$'::text)")) @db.VarChar(255)
  recovery_sent_at            DateTime?               @db.Timestamptz(6)
  email_change_token_new      String?                 @unique(map: "email_change_token_new_idx", where: raw("((email_change_token_new)::text !~ '^[0-9 ]*$'::text)")) @db.VarChar(255)
  email_change                String?                 @db.VarChar(255)
  email_change_sent_at        DateTime?               @db.Timestamptz(6)
  last_sign_in_at             DateTime?               @db.Timestamptz(6)
  raw_app_meta_data           Json?
  raw_user_meta_data          Json?
  is_super_admin              Boolean?
  created_at                  DateTime?               @db.Timestamptz(6)
  updated_at                  DateTime?               @db.Timestamptz(6)
  phone                       String?                 @unique
  phone_confirmed_at          DateTime?               @db.Timestamptz(6)
  phone_change                String?                 @default("")
  phone_change_token          String?                 @default("") @db.VarChar(255)
  phone_change_sent_at        DateTime?               @db.Timestamptz(6)
  confirmed_at                DateTime?               @default(dbgenerated("LEAST(email_confirmed_at, phone_confirmed_at)")) @db.Timestamptz(6)
  email_change_token_current  String?                 @unique(map: "email_change_token_current_idx", where: raw("((email_change_token_current)::text !~ '^[0-9 ]*$'::text)")) @default("") @db.VarChar(255)
  email_change_confirm_status Int?                    @default(0) @db.SmallInt
  banned_until                DateTime?               @db.Timestamptz(6)
  reauthentication_token      String?                 @unique(map: "reauthentication_token_idx", where: raw("((reauthentication_token)::text !~ '^[0-9 ]*$'::text)")) @default("") @db.VarChar(255)
  reauthentication_sent_at    DateTime?               @db.Timestamptz(6)
  is_sso_user                 Boolean                 @default(false)
  deleted_at                  DateTime?               @db.Timestamptz(6)
  is_anonymous                Boolean                 @default(false)
  identities                  identities[]
  mfa_factors                 mfa_factors[]
  mfa_recovery_code_sets      mfa_recovery_code_sets?
  oauth_authorizations        oauth_authorizations[]
  oauth_consents              oauth_consents[]
  one_time_tokens             one_time_tokens[]
  scim_users                  scim_users[]
  sessions                    sessions[]
  webauthn_challenges         webauthn_challenges[]
  webauthn_credentials        webauthn_credentials[]
  user_profile                user_profiles?
  invitations                 invitation[]

  @@index([created_at(sort: Desc)], map: "idx_users_created_at_desc")
  @@index([email], map: "idx_users_email")
  @@index([last_sign_in_at(sort: Desc)], map: "idx_users_last_sign_in_at_desc")
  @@index([instance_id])
  @@index([is_anonymous])
  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model webauthn_challenges {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?  @db.Uuid
  challenge_type String
  session_data   Json
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  expires_at     DateTime @db.Timestamptz(6)
  users          users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at])
  @@index([user_id])
  @@schema("auth")
}

model webauthn_credentials {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  credential_id    Bytes     @unique
  public_key       Bytes
  attestation_type String    @default("")
  aaguid           String?   @db.Uuid
  sign_count       BigInt    @default(0)
  transports       Json      @default("[]")
  backup_eligible  Boolean   @default(false)
  backed_up        Boolean   @default(false)
  friendly_name    String    @default("")
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at     DateTime? @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@schema("auth")
}

enum aal_level {
  aal1
  aal2
  aal3

  @@schema("auth")
}

enum code_challenge_method {
  s256
  plain

  @@schema("auth")
}

enum factor_status {
  unverified
  verified

  @@schema("auth")
}

enum factor_type {
  totp
  webauthn
  phone
  recovery_code

  @@schema("auth")
}

enum oauth_authorization_status {
  pending
  approved
  denied
  expired

  @@schema("auth")
}

enum oauth_client_type {
  public
  confidential

  @@schema("auth")
}

enum oauth_registration_type {
  dynamic
  manual

  @@schema("auth")
}

enum oauth_response_type {
  code

  @@schema("auth")
}

enum one_time_token_type {
  confirmation_token
  reauthentication_token
  recovery_token
  email_change_token_new
  email_change_token_current
  phone_change_token

  @@schema("auth")
}

enum user_role {
  DRIVER
  MECHANIC
  ADMIN_L1
  ADMIN_L2
  SUPER_ADMIN

  @@schema("public")
}

enum vehicle_status {
  ACTIVE
  FAULT_REPORTED
  AT_REPAIR_SHOP
  UNDER_DIAGNOSIS
  AWAITING_APPROVAL
  REPAIR_IN_PROGRESS
  FIXED
  READY_FOR_PICKUP
  RETIRED

  @@schema("public")
}

enum assignment_status {
  ACTIVE
  ENDED
  REASSIGNED

  @@schema("public")
}

enum deposit_status {
  PENDING
  CONFIRMED
  REJECTED

  @@schema("public")
}

enum repair_status {
  REPORTED
  AT_SHOP
  DIAGNOSED
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  FIXED
  PICKED_UP
  REJECTED

  @@schema("public")
}

enum expense_status {
  PENDING
  APPROVED
  REJECTED
  PAID

  @@schema("public")
}

model user_profiles {
  id           String    @id(map: "user_profiles_pkey") @db.Uuid
  fullName     String?
  email        String?   @unique(map: "user_profiles_email_key")
  phone        String?   @unique
  passwordHash String?
  isActive     Boolean   @default(true)
  // Auth profile fields
  first_name        String?
  last_name         String?
  phone_number      String?
  password          String?
  country           String?
  state             String?
  date_of_birth     DateTime?
  terms_accepted    Boolean?
  otp_count         Int?
  otp_generated_at  DateTime?
  email_confirmed_at DateTime?
  last_sign_in_at   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  driverProfile     driver?
  mechanicProfile   mechanic?
  assignedVehicles  vehicle[]    @relation("CurrentDriver")
  deposits          deposit[]    @relation("DepositDriver")
  reportedRepairs   repair[]     @relation("ReportedBy")
  handledRepairs    repair[]     @relation("HandledBy")
  requestedExpenses expense[]    @relation("RequestedBy")
  approvedExpenses  expense[]    @relation("ApprovedBy")
  auditLogs         audit_log[]
  user_role         user_roles[]
  sessions          session[]
  users             users        @relation(fields: [id], references: [id], onDelete: Cascade, map: "user_profiles_id_fkey")

  @@map("user_profiles")
  @@schema("public")
}

model driver {
  id                   String   @id @default(uuid())
  userId               String   @unique @db.Uuid
  licenseNumber        String?
  address              String?
  emergencyPhone       String?
  dateOfBirth          DateTime?
  emergencyContactName String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user        user_profiles       @relation(fields: [userId], references: [id])
  deposits    deposit[]
  assignments vehicle_assignment[]

  @@map("drivers")
  @@schema("public")
}

model mechanic {
  id               String   @id @default(uuid())
  userId           String   @unique @db.Uuid
  specialty        String?
  certifications   String?
  yearsOfExperience Int?
  hourlyRate       Decimal? @db.Decimal(14, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user user_profiles @relation(fields: [userId], references: [id])

  @@map("mechanics")
  @@schema("public")
}

model vehicle {
  id                   String        @id @default(uuid())
  plateNumber          String        @unique
  make                 String
  model                String
  year                 Int?
  color                String?
  ownershipType        String        @default("COMPANY_OWNED")
  currentMileage       Int           @default(0)
  status               vehicle_status @default(ACTIVE)
  currentDriverId      String?   @db.Uuid
  purchasePrice        Decimal?      @db.Decimal(14, 2)
  insuranceExpiry      DateTime?
  roadworthinessExpiry DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  currentDriver user_profiles?      @relation("CurrentDriver", fields: [currentDriverId], references: [id])
  assignments   vehicle_assignment[]
  deposits      deposit[]
  repairs       repair[]
  expenses      expense[]

  @@map("vehicles")
  @@schema("public")
}

model vehicle_assignment {
  id            String           @id @default(uuid())
  vehicleId     String
  driverId      String
  weeklyPayment Decimal          @db.Decimal(14, 2)
  startDate     DateTime         @default(now())
  endDate       DateTime?
  status        assignment_status @default(ACTIVE)
  handoverNotes String?
  startOdometer Int?
  endOdometer   Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  vehicle  vehicle   @relation(fields: [vehicleId], references: [id])
  driver   driver    @relation(fields: [driverId], references: [id])
  deposits deposit[]

  @@map("vehicle_assignments")
  @@schema("public")
}

model deposit {
  id             String        @id @default(uuid())
  driverId       String
  vehicleId      String
  assignmentId   String
  weekStartDate  DateTime
  weekEndDate    DateTime
  expectedAmount Decimal       @db.Decimal(14, 2)
  amount         Decimal       @db.Decimal(14, 2)
  paymentMethod  String
  reference      String?
  receiptUrl     String?
  status         deposit_status @default(PENDING)
  submittedAt    DateTime      @default(now())
  confirmedAt    DateTime?
  confirmedById  String?   @db.Uuid
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  driver      driver            @relation(fields: [driverId], references: [id])
  vehicle     vehicle           @relation(fields: [vehicleId], references: [id])
  assignment  vehicle_assignment @relation(fields: [assignmentId], references: [id])
  confirmedBy user_profiles?    @relation("DepositDriver", fields: [confirmedById], references: [id])

  @@unique([assignmentId, weekStartDate])
  @@map("deposits")
  @@schema("public")
}

model repair {
  id               String       @id @default(uuid())
  vehicleId        String
  reportedById     String   @db.Uuid
  mechanicId       String?  @db.Uuid
  issueCategory    String
  description      String
  photos           String[]
  reportedAt       DateTime     @default(now())
  droppedOffAt     DateTime?
  diagnosedAt      DateTime?
  approvedAt       DateTime?
  fixedAt          DateTime?
  pickedUpAt       DateTime?
  status           repair_status @default(REPORTED)
  diagnosisNotes   String?
  estimateCost     Decimal?     @db.Decimal(14, 2)
  finalCost        Decimal?     @db.Decimal(14, 2)
  mechanicNotes    String?
  completionPhotos String[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vehicle    vehicle        @relation(fields: [vehicleId], references: [id])
  reportedBy user_profiles  @relation("ReportedBy", fields: [reportedById], references: [id])
  mechanic   user_profiles? @relation("HandledBy", fields: [mechanicId], references: [id])
  items      repair_item[]
  expenses   expense[]

  @@map("repairs")
  @@schema("public")
}

model repair_item {
  id        String   @id @default(uuid())
  repairId  String
  name      String
  itemType  String
  quantity  Int      @default(1)
  unitCost  Decimal  @db.Decimal(14, 2)
  totalCost Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  repair repair @relation(fields: [repairId], references: [id])

  @@map("repair_items")
  @@schema("public")
}

model expense {
  id            String        @id @default(uuid())
  vehicleId     String
  repairId      String?
  title         String
  category      String
  amount        Decimal       @db.Decimal(14, 2)
  receiptUrl    String?
  status        expense_status @default(PENDING)
  requestedById String   @db.Uuid
  approvedById  String?  @db.Uuid
  approvedAt    DateTime?
  notes         String?
  expenseDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  vehicle     vehicle        @relation(fields: [vehicleId], references: [id])
  repair      repair?        @relation(fields: [repairId], references: [id])
  requestedBy user_profiles  @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedBy  user_profiles? @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@map("expenses")
  @@schema("public")
}

model audit_log {
  id          String   @id @default(uuid())
  userId      String   @db.Uuid
  action      String
  entity      String
  entityId    String
  beforeValue Json?
  afterValue  Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user user_profiles @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@schema("public")
}

model user_roles {
  id           String        @id(map: "user_roles_pkey") @db.Uuid
  user_id      String        @db.Uuid
  role         user_role
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now())
  created_by   String?       @db.Uuid
  updated_by   String?       @db.Uuid
  user_profile user_profiles @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_roles_user_id_fkey")

  @@unique([user_id, role], map: "user_roles_user_id_role_key")
  @@schema("public")
}

model session {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  accessToken  String
  refreshToken String?
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user_profile user_profiles @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("public")
}

enum invitation_status {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@schema("public")
}

model invitation {
  id          String             @id @default(uuid())
  email       String             @unique
  first_name  String
  last_name   String
  role        user_role
  phone_number String?
  token       String             @unique @default(uuid())
  status      invitation_status  @default(PENDING)
  expires_at  DateTime
  invited_by  String             @db.Uuid
  accepted_at DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  inviter users @relation(fields: [invited_by], references: [id], onDelete: Cascade, map: "invitations_invited_by_fkey")

  @@map("invitations")
  @@schema("public")
}
